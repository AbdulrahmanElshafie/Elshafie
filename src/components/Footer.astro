---
import { profile } from '../data/profile';
import { getPath } from '../utils/paths';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Col 1: Identity & Positioning -->
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="logo-mark">AE</span>
          <span class="logo-name">{profile.name}</span>
        </div>
        <p class="footer-title">{profile.title}</p>
        <p class="footer-summary">
          {profile.positioningStatement}
        </p>
        <div class="footer-location">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>{profile.location}, {profile.country}</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          <li><a href={getPath('/work/')}>Selected Work</a></li>
          <li><a href={getPath('/about/')}>About &amp; Background</a></li>
          <li><a href={getPath('/about/#experience')}>Experience</a></li>
          <li><a href={getPath('/contact/')}>Start a Conversation</a></li>
          <li><a href={getPath('/sitemap-index.xml')}>Sitemap (XML)</a></li>
        </ul>
      </div>

      <!-- Col 3: Case Studies Direct Access -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Case Studies</h3>
        <ul class="footer-links">
          <li><a href={getPath('/work/autowa/')}>AutoWA <span class="footer-pill">CV &amp; Automation</span></a></li>
          <li><a href={getPath('/work/docmanager/')}>DocManager <span class="footer-pill">Django &amp; RBAC</span></a></li>
          <li><a href={getPath('/work/autowritey/')}>Autowritey <span class="footer-pill">LLM Pipeline</span></a></li>
        </ul>
      </div>

      <!-- Col 4: Direct Channels -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">Connect Directly</h3>
        <ul class="footer-links">
          <li>
            <a href={`mailto:${profile.email}`} class="footer-contact-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>Email</span>
            </a>
          </li>
          <li>
            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href={profile.github} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a href={`tel:${profile.phone.replace(/\s+/g, '')}`} class="footer-contact-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{profile.phone}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} {profile.name}. All rights reserved.
      </p>
      <p class="footer-tech-note">
        Static SSG built with Astro · No runtime trackers · WCAG 2.2 AA compliant
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0D0F10;
    color: #8A9199;
    padding: 72px 0 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1.2fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #F0F2F4;
    background-color: #1D2226;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 8px;
    border-radius: 6px;
  }

  .logo-name {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .footer-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #D4883A;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin: 0;
  }

  .footer-summary {
    color: #94A3B8;
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 380px;
    margin: 0;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: #CBD5E1;
    margin-top: 4px;
  }

  .footer-location svg {
    color: #D4883A;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: #94A3B8;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #94A3B8;
    background-color: rgba(255, 255, 255, 0.06);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    font-size: 0.8125rem;
    color: #64748B;
  }

  .footer-copy {
    margin: 0;
  }

  .footer-tech-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
