---
import { getPath } from '../utils/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { label: "Work", href: getPath('/work/') },
  { label: "About", href: getPath('/about/') },
  { label: "Experience", href: getPath('/about/#experience') },
  { label: "Contact", href: getPath('/contact/') }
];
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <!-- Brand / Identity -->
    <a href={getPath('/')} class="brand-link" aria-label="Abdulrahman Saeed Elshafie Homepage">
      <div class="brand-mark">
        <span class="brand-monogram">AE</span>
        <span class="brand-dot"></span>
      </div>
      <div class="brand-text">
        <span class="brand-name">Abdulrahman Elshafie</span>
        <span class="brand-role">Backend &amp; AI Engineer</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== getPath('/') && currentPath.startsWith(item.href) && !item.href.includes('#'));
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={["nav-link", { "is-active": isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="nav-cta">
        <a href={getPath('/contact/')} class="btn btn-primary btn-sm">
          <span>Start a conversation</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33333M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <!-- Theme Toggle -->
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle-btn"
          aria-label="Toggle dark mode"
          title="Toggle dark / light mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu Button + Theme Toggle -->
    <div class="mobile-right-controls">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle-btn-mobile"
        aria-label="Toggle dark mode"
        title="Toggle dark / light mode"
      >
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="container mobile-nav-inner">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-nav-footer">
        <a href={getPath('/contact/')} class="btn btn-primary" style="width: 100%;">
          <span>Start a conversation</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33333M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
    transition: background-color 0.22s ease, border-color 0.22s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Brand Mark */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .brand-monogram {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-bg);
    letter-spacing: -0.05em;
  }

  .brand-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  /* Navigation Links */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 8px 14px;
    border-radius: 6px;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background-color: var(--color-surface-alt);
  }

  .nav-link.is-active {
    color: var(--color-ink);
    font-weight: 600;
    background-color: var(--color-surface-alt);
  }

  /* Mobile Toggle */
  .mobile-right-controls {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobile Dropdown */
  .mobile-nav {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    padding: 20px 0 24px;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }

  .mobile-nav-link {
    display: block;
    padding: 10px 14px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border-radius: 6px;
    text-decoration: none;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-accent);
  }

  @media (max-width: 820px) {
    .desktop-nav {
      display: none;
    }

    .mobile-right-controls {
      display: flex;
    }
  }
</style>

<script>
  // ── Mobile nav toggle ──────────────────────────────────────
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        mobileNav.setAttribute('hidden', '');
      } else {
        mobileNav.removeAttribute('hidden');
      }
    });

    const mobileLinks = mobileNav.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('hidden', '');
      });
    });
  }

  // ── Theme toggle ───────────────────────────────────────────
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem('portfolio-theme', theme); } catch (e) {}
  }

  function getTheme(): string {
    try {
      const stored = localStorage.getItem('portfolio-theme');
      if (stored) return stored;
    } catch (e) {}
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || getTheme();
    applyTheme(current === 'dark' ? 'light' : 'dark');
  }

  const toggleBtns = document.querySelectorAll('#theme-toggle-btn, #theme-toggle-btn-mobile');
  toggleBtns.forEach(btn => btn.addEventListener('click', toggleTheme));
</script>
