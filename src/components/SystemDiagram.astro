---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["system-diagram", { "is-compact": compact }]} aria-label="System Flow: Problem to Outcome Architecture">
  <div class="diagram-header">
    <div class="diagram-status">
      <span class="status-indicator"></span>
      <span class="diagram-tag">ARCHITECTURE PARADIGM // PROBLEM → SYSTEM → OUTCOME</span>
    </div>
    <span class="diagram-meta">Deterministic Workflow Engine</span>
  </div>

  <div class="diagram-flow">
    <!-- Step 1: Problem / Need -->
    <div class="diagram-node node-problem">
      <div class="node-badge">01 · CONTEXT</div>
      <div class="node-title">Business Need</div>
      <p class="node-desc">Operational friction, acquisition targets, or manual bottlenecks.</p>
      <div class="node-tech">User Friction · Analytics</div>
    </div>

    <div class="flow-connector" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Step 2: System Architecture -->
    <div class="diagram-node node-backend">
      <div class="node-badge">02 · BACKEND</div>
      <div class="node-title">Backend API Core</div>
      <p class="node-desc">Django RESTful services, transactional schemas &amp; JWT/RBAC.</p>
      <div class="node-tech">Python · Django · PostgreSQL</div>
    </div>

    <div class="flow-connector" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Step 3: AI & Automation -->
    <div class="diagram-node node-ai">
      <div class="node-badge">03 · AI &amp; CV</div>
      <div class="node-title">AI / Automation Engine</div>
      <p class="node-desc">Chained LLM pipelines, SerpAPI grounding, OpenCV automation.</p>
      <div class="node-tech">Pipelines · OpenCV · SerpAPI</div>
    </div>

    <div class="flow-connector" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Step 4: Outcome -->
    <div class="diagram-node node-outcome">
      <div class="node-badge">04 · OUTCOME</div>
      <div class="node-title">Verified Result</div>
      <p class="node-desc">Zero-duplicate recovery, reliable data flows &amp; automated scale.</p>
      <div class="node-tech">Reliability · Adoption</div>
    </div>
  </div>

  <div class="diagram-footer">
    <div class="footer-metric">
      <span class="metric-label">Execution Guard:</span>
      <span class="metric-val">Atomic Checkpoints</span>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-metric">
      <span class="metric-label">Validation:</span>
      <span class="metric-val">Schema &amp; Web Grounding</span>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-metric">
      <span class="metric-label">Integration:</span>
      <span class="metric-val">Stateless REST APIs</span>
    </div>
  </div>
</div>

<style>
  .system-diagram {
    background-color: var(--color-bg-dark);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 16px 36px -8px rgba(18, 23, 32, 0.35);
    color: #FAF8F5;
  }

  .diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .diagram-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .diagram-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #94A3B8;
  }

  .diagram-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #F59E0B;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .diagram-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 10px;
  }

  .diagram-node {
    background-color: var(--color-navy-surface);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .diagram-node:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .node-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #94A3B8;
  }

  .node-problem .node-badge { color: #CBD5E1; }
  .node-backend .node-badge { color: #F59E0B; }
  .node-ai .node-badge { color: #A5B4FC; }
  .node-outcome .node-badge { color: #34D399; }

  .node-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
  }

  .node-desc {
    font-size: 0.75rem;
    color: #94A3B8;
    line-height: 1.4;
    margin: 0;
    flex-grow: 1;
  }

  .node-tech {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #CBD5E1;
    background: rgba(0, 0, 0, 0.25);
    padding: 4px 6px;
    border-radius: 4px;
    margin-top: 4px;
  }

  .flow-connector {
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-footer {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #94A3B8;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-metric {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .metric-label {
    color: #64748B;
  }

  .metric-val {
    color: #FAF8F5;
    font-weight: 500;
  }

  .footer-divider {
    width: 1px;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 900px) {
    .diagram-flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .flow-connector {
      transform: rotate(90deg);
      margin: 2px 0;
    }

    .footer-divider {
      display: none;
    }

    .diagram-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
